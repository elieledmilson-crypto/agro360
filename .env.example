# ---------------------------------------------------------------
# Agro360 — variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha os valores reais.
# O arquivo `.env` NÃO deve ser versionado.
# ---------------------------------------------------------------

# Supabase — usadas no frontend Vite.
# A URL e a chave publishable podem ser expostas ao navegador.
# Nunca coloque uma chave secret/service_role em VITE_*.
VITE_SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLO

# Agro360 Intelligence — lidas apenas pelo servidor/função.
GEMINI_API_KEY=coloque_sua_chave_aqui
GEMINI_MODEL=gemini-3.6-flash

# Porta do servidor HTTP local de IA.
AI_SERVER_PORT=8787
