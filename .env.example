# ---------------------------------------------------------------
# Agro360 — variáveis de ambiente do servidor de IA
#
# Copie este arquivo para `.env` e preencha com valores reais.
# O arquivo `.env` NÃO deve ser versionado (já está no .gitignore).
#
# O servidor (server/index.mjs) lê este arquivo manualmente e injeta
# os valores em process.env antes de iniciar. Nenhuma dependência
# extra é necessária.
# ---------------------------------------------------------------

# Chave da OpenAI. Lida apenas pelo servidor Node.
OPENAI_API_KEY=

# Identificador do modelo OpenAI. Informe um modelo compatível com
# a API utilizada. Consulte a documentação oficial atual da OpenAI
# para escolher o modelo adequado.
OPENAI_MODEL=

# Porta do servidor HTTP local de IA.
AI_SERVER_PORT=8787# ---------------------------------------------------------------
# Agro360 — variáveis de ambiente do servidor de IA
#
# Copie este arquivo para `.env` e preencha com valores reais.
# O arquivo `.env` NÃO deve ser versionado (já está no .gitignore).
#
# O servidor (server/index.mjs) lê este arquivo manualmente e injeta
# os valores em process.env antes de iniciar. Nenhuma dependência
# extra é necessária.
# ---------------------------------------------------------------

# Chave da API do Google Gemini.
# Lida apenas pelo servidor Node.
GEMINI_API_KEY=coloque_sua_chave_aqui

# Modelo Gemini utilizado pelo Agro360 Intelligence.
GEMINI_MODEL=gemini-3.6-flash

# Porta do servidor HTTP local de IA.
AI_SERVER_PORT=8787